# -----------------------------------------------------------------
# Todas as variáveis abaixo são OPCIONAIS.
# As skills funcionam em modo só-rascunho sem nada configurado: escrevem
# legenda, gancho, hashtags e roteiro de slides para você postar no app.
# Coloque uma PUBLORA_API_KEY para enviar a mídia e agendar automaticamente.
# -----------------------------------------------------------------

# Chave de API da Publora - cadastro grátis em https://app.publora.com/signup
PUBLORA_API_KEY=sk_your_key_here

# ID da conexão do Instagram (formato: instagram-11223344)
# No painel da Publora: Channels > sua conta do Instagram.
# Copie tudo, incluindo o prefixo instagram-.
# Exige conta Comercial ou de Criador (conta pessoal não funciona).
INSTAGRAM_PLATFORM_ID=instagram-your_id_here

# -----------------------------------------------------------------
# Token do Apify (opcional) - permite às skills de leitura buscar dados
# reais de hashtags e perfis. Sem token, elas pedem que você cole os dados.
#
# Cadastro: https://console.apify.com/sign-up
# Token:    https://console.apify.com/settings/integrations
# -----------------------------------------------------------------
APIFY_TOKEN=apify_api_your_token_here

# -----------------------------------------------------------------
# Avançado (Nível 2): se você criou seu próprio publicador (ex.: na
# Instagram Graph API), defina aqui o comando que as skills chamam na
# aprovação. Deixe comentado se não tiver um funcionando.
# -----------------------------------------------------------------
# INSTAGRAM_SKILLS_CUSTOM_POSTER=python /caminho/para/meu-publicador.py

# ─────────────────────────────────────────────────────────────────
# Token Pixfaro (opcional) - gera ilustrações (imagem do feed, slides de
# carrossel, cards de frase) e anexa na publicação, com @ e cor da marca
# sobrepostos com exatidão.
#
# Cadastro e docs: https://pixfaro.com  (formato da chave: pf_live_...)
#
# Sem token, as skills escrevem o prompt e pedem que você gere a imagem
# e cole a URL.
# ─────────────────────────────────────────────────────────────────
PIXFARO_TOKEN=pf_live_your_token_here
